# The office machine's worker gateway, in front of the engines the research app
# already runs. Install: sudo cp deploy/mascotte-worker.service /etc/systemd/system/
#                       sudo systemctl enable --now mascotte-worker
[Unit]
Description=mascotteAPI GPU worker gateway (office 5090, 127.0.0.1:7100)
After=network-online.target seeyourfutureself.service ollama.service
Wants=network-online.target

[Service]
User=khitan
WorkingDirectory=/home/khitan/mascotteAPI
# WSL keeps nvidia-smi in /usr/lib/wsl/lib, outside systemd's default PATH.
Environment=PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin:/usr/lib/wsl/lib
ExecStart=/home/khitan/mascotteAPI/scripts/run-local.sh
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
